{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activemirror.ai/schemas/active-mirror-revocation-cascade.schema.json",
  "title": "Active Mirror Revocation Cascade",
  "description": "Public-safe contract for showing how a revoked permission, memory, export, or body receipt changes downstream state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "mode",
    "claimBoundary",
    "events",
    "coveredFailureClass",
    "privateEnforcement"
  ],
  "properties": {
    "schemaVersion": { "const": "active_mirror.revocation_cascade.v1" },
    "version": { "type": "string", "pattern": "^2026\\." },
    "mode": { "const": "public_safe_cascade_contract" },
    "claimBoundary": { "type": "string", "minLength": 20 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/revocationCascadeEvent" }
    },
    "coveredFailureClass": { "const": "revocation cascade opacity" },
    "privateEnforcement": { "const": "body_required" }
  },
  "$defs": {
    "revocationCascadeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "revoke", "downstreamEffect", "state", "receiptRequired"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "revoke": { "type": "string", "pattern": "^[a-z0-9_.:-]{3,120}$" },
        "downstreamEffect": { "type": "string", "minLength": 10 },
        "state": { "enum": ["public_contract_ready", "private_body_required"] },
        "receiptRequired": { "type": "string", "pattern": "^[a-z0-9_.:-]{3,120}$" }
      }
    }
  }
}
